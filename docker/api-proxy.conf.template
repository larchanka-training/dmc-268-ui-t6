# The /api/ route of a stack without an edge proxy: rendered at start by 16-api-proxy.sh, included
# by nginx.conf. The API gets the request as it does behind Caddy (deploy/edge/Caddyfile in the
# API repo): the same path and Host, one origin for the browser.
location /api/ {
    # A variable makes nginx resolve the name per request, not once at start: the UI can start
    # before the backend, and a recreated backend has a new address.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    # Caddy's dial timeout. The default 60 s holds a request on the address of a removed container
    # for a minute; it fails fast instead, and the next lookup finds the new one.
    proxy_connect_timeout 3s;

    # The headers of the API alone, as behind Caddy: the server block's are for the UI's pages.
    add_header_inherit off;

    proxy_set_header Host $http_host;
    # This nginx is the first hop: what a client sent in these headers is overwritten, as in Caddy.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;

    # GET /api/stream is SSE: each event goes out as it arrives. Its keepalive (15 s) is well
    # under the default proxy_read_timeout (60 s).
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
}
